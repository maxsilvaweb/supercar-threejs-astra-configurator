---
import { ConfigureApp } from "../../components/ConfigureApp";
import { getCar, listConfigurableCars } from "../../cars";
import { CONFIG_GARAGE_MODEL, GARAGE_VENT_URL, RIM_MODEL } from "../../lib/constants";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return listConfigurableCars().map((car) => ({ params: { slug: car.slug } }));
}

const { slug } = Astro.params;
const car = slug ? getCar(slug) : undefined;
---

<Layout title={`${car?.name || "Configure"} · silvaweb`}>
  {car?.model ? (
    <link slot="head" rel="preload" href={car.model} as="fetch" crossorigin media="(min-width: 768px)" />
  ) : null}
  <link slot="head" rel="preload" href={CONFIG_GARAGE_MODEL} as="fetch" crossorigin media="(min-width: 768px)" />
  <link slot="head" rel="preload" href={RIM_MODEL} as="fetch" crossorigin media="(min-width: 768px)" />
  <link slot="head" rel="preload" href={GARAGE_VENT_URL} as="fetch" crossorigin media="(min-width: 768px)" />
  <ConfigureApp client:only="react" slug={slug || ""} />
</Layout>
